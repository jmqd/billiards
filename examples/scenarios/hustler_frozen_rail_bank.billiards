# The Hustler frozen-rail bank manual check.
# Source: whitepapers/billiards_on_the_big_screen_the_hustler.pdf
# Goal: 8-ball and cue ball are both frozen to the right side rail, with the cue frozen directly
# behind the 8. A firm elevated top-right-English hit banks the 8 into the top-right corner.
table brunswick_gc4_9ft
ball cue frozen right (5.67)
ball eight frozen right (5.85)
cue_strike(default).mass_ratio(1.0).energy_loss(0.1)
trace(max_events: 12)
shot(cue).heading(12deg).speed(88ips).tip(side: 0.22R, height: 0.28R).using(default)
