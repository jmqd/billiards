# Jump-over full-ball showcase.
# Goal: default 45-degree jump() cue elevation clears a blocker, then exposes the unsupported airborne contact with the 2.
table brunswick_gc4_9ft
ball cue at (2.00, 2.00)
ball one at (2.00, 2.68)
ball two at (2.00, 4.00)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
trace(max_events: 8)
shot(cue).heading(0deg).speed(160ips).tip(side: 0.0R, height: 0.0R).jump().using(default)
