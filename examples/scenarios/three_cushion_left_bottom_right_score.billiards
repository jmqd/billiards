# Legal three-cushion scoring shot: cue contacts yellow, then left/bottom/right cushions, then red.
# Goal: vertical mirror of the compact left/top/right plus-English scoring path.
table three_cushion_carom_10ft
game three_cushion
ball cue at (3.354, 4.691)
ball yellow at (2.491, 2.162)
ball red at (2.762, 4.112)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
simulation(default)
  .preset(three_cushion)
  .max_events(24)
trace(max_events: 24)
shot(cue).heading(198.859deg).speed(108ips).tip(side: -0.39R, height: 0.11R).using(default)
