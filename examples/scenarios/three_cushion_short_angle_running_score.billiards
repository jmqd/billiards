# Short-angle system score: yellow first, then right/top/left cushions, then red.
# Source: https://usba-carom.org/?catid=95&id=135%3Aa-simple-but-effective-short-angle-system&view=article
# Source diagram: https://usba-carom.org/images/InstructionPix/Shot-5.jpg
# Goal: exercise a soft half-ball family with near-limit running English and a compact third-rail score.
table three_cushion_carom_10ft
game three_cushion
ball cue at (1.446337, 3.886697)
ball yellow at (3.374876, 6.389810)
ball red at (0.415000, 6.282000)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
ball_ball(carom).normal_restitution(0.98).tangential_friction(0.05)
rail_response(lively).normal_restitution(0.82).tangential_friction(0.82)
rails(carom).default(lively)
simulation(default)
  .collision_model(throw_aware)
  .ball_ball(carom)
  .rail_model(spin_aware)
  .rails(carom)
  .conditions(heated_carom)
  .max_events(40)
trace(max_events: 40)
shot(cue).heading(37.500000deg).speed(176.565108ips).tip(side: -0.430000R, height: 0.232180R).using(default)
