# Double-rail / snake score vertical mirror: cue checks with strong opposite side and returns to the first cushion as the third cue rail.
# Goal: high-speed top/bottom/top rail pattern; only two physical cushions produce the three-cushion count before red.
table three_cushion_carom_10ft
game three_cushion
ball cue at (2.721, 1.263)
ball yellow at (3.407, 3.474)
ball red at (0.579, 6.231)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
ball_ball(carom).normal_restitution(0.98).tangential_friction(0.05)
rail_response(lively).normal_restitution(0.82).tangential_friction(0.82)
rails(carom).default(lively)
simulation(default)
  .collision_model(throw_aware)
  .ball_ball(carom)
  .rail_model(spin_aware)
  .rails(carom)
  .conditions(heated_carom)
  .max_events(36)
trace(max_events: 36)
shot(cue).heading(14.958deg).speed(216ips).tip(side: 0.21R, height: 0.02R).using(default)
