# Legal three-cushion scoring shot: cue contacts yellow, then right/top/left cushions, then red.
# Goal: clean three-cushion sequence with no pockets on the 10 ft heated carom table.
table three_cushion_carom_10ft
game three_cushion
ball cue at (0.700, 1.000)
ball yellow at (1.200, 2.100)
ball red at (0.849610121, 6.726582133)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
simulation(default)
  .preset(three_cushion)
  .max_events(24)
trace(max_events: 24)
shot(cue).heading(32.107371737deg).speed(148.935889661ips).tip(side: 0.225244908R, height: 0.245531700R).elevation(8.732570633deg).using(default)
