# The Hustler frozen-rail bank source fixture.
# Source: whitepapers/billiards_on_the_big_screen_the_hustler.pdf
# Target physical shot: 8 and cue are frozen on the right rail; a firm elevated top-right-English hit banks the 8 into top-right.
# Current limitation: the simulator reports a terminal unsupported airborne mixed rail/ball contact instead of claiming that bank.
table brunswick_gc4_9ft
ball cue frozen right (5.67)
ball eight frozen right (5.85)
cue_strike(default).mass_ratio(1.0).energy_loss(0.1)
trace(max_events: 12)
shot(cue).heading(12deg).speed(88ips).tip(side: 0.22R, height: 0.28R).using(default)
