# Ticky with a repeated cushion count: left rail, yellow, left rail again, bottom rail, then red.
# Source: https://drdavepoolinfo.com/faq/30-90-rules/carom/tickie/
# Rule source: https://files.umb-carom.org/Public/Rules/CAROM%20BILLIARD%20RULES.pdf
# Goal: prove separate same-cushion contacts count toward a legal three-cushion score.
table three_cushion_carom_10ft
game three_cushion
ball cue at (1.977, 7.324)
ball yellow at (0.445, 1.030)
ball red at (2.458, 2.325)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
ball_ball(carom).normal_restitution(0.98).tangential_friction(0.05)
rail_response(lively).normal_restitution(0.82).tangential_friction(0.82)
rails(carom).default(lively)
simulation(default)
  .collision_model(throw_aware)
  .ball_ball(carom)
  .rail_model(spin_aware)
  .rails(carom)
  .conditions(heated_carom)
  .max_events(36)
trace(max_events: 36)
shot(cue).heading(197.617deg).speed(216ips).tip(side: -0.17R, height: 0.06R).using(default)
