# Natural-angle standard scoring carom: yellow first, then right/bottom/left cushions, then red.
# Source: https://usba-carom.org/?catid=95&id=111%3Ahow-to-play-3-cushion-billiards&view=article
# Supporting natural-angle reference: https://drdavepoolinfo.com/faq/30-90-rules/30-degree-rule/
# Goal: validate the fundamental object-first three-rail score with near-center running follow.
table three_cushion_carom_10ft
game three_cushion
ball cue at (1.096034, 3.373898)
ball yellow at (2.024564, 3.211003)
ball red at (0.400700, 1.967600)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
ball_ball(carom).normal_restitution(0.98).tangential_friction(0.05)
rail_response(lively).normal_restitution(0.82).tangential_friction(0.82)
rails(carom).default(lively)
simulation(default)
  .collision_model(throw_aware)
  .ball_ball(carom)
  .rail_model(spin_aware)
  .rails(carom)
  .conditions(heated_carom)
  .max_events(40)
trace(max_events: 40)
shot(cue).heading(101.725733deg).speed(228.587753ips).tip(side: 0.027883R, height: 0.377174R).using(default)
