# Reverse-English hold-up score: yellow first, then left/bottom/right cushions, then red.
# Source: https://usba-carom.org/?catid=95&id=134%3Ashots-that-i-love-to-play&view=article
# Source diagram: https://usba-carom.org/images/InstructionPix/Shot-1.jpg
# Goal: validate a hard thin hit with heavy reverse that selects the long cushion before the short cushion.
table three_cushion_carom_10ft
game three_cushion
ball cue at (1.804850, 3.877052)
ball yellow at (0.658556, 0.999379)
ball red at (3.316300, 2.597500)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
ball_ball(carom).normal_restitution(0.98).tangential_friction(0.05)
rail_response(lively).normal_restitution(0.82).tangential_friction(0.82)
rails(carom).default(lively)
simulation(default)
  .collision_model(throw_aware)
  .ball_ball(carom)
  .rail_model(spin_aware)
  .rails(carom)
  .conditions(heated_carom)
  .max_events(50)
trace(max_events: 50)
shot(cue).heading(201.697381deg).speed(262.704090ips).tip(side: -0.431883R, height: 0.132893R).using(default)
