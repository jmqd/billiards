# Legal three-cushion scoring shot: cue contacts yellow, then bottom/right/top cushions, then red.
# Goal: cross-table scoring route that keeps the red stationary until final cue-ball contact.
table three_cushion_carom_10ft
game three_cushion
ball cue at (0.633, 4.591)
ball yellow at (2.087, 2.445)
ball red at (0.825, 5.957)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
ball_ball(carom).normal_restitution(0.98).tangential_friction(0.05)
rail_response(lively).normal_restitution(0.82).tangential_friction(0.82)
rails(carom).default(lively)
simulation(default)
  .collision_model(throw_aware)
  .ball_ball(carom)
  .rail_model(spin_aware)
  .rails(carom)
  .conditions(heated_carom)
  .max_events(24)
trace(max_events: 24)
shot(cue).heading(148.010deg).speed(152ips).tip(side: -0.21R, height: 0.28R).using(default)
