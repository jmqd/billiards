# Legal three-cushion scoring shot: cue contacts yellow, then top/right/left cushions, then red.
# Goal: near-horizontal opening hit that uses side spin to find the third cushion and score.
table three_cushion_carom_10ft
game three_cushion
ball cue at (1.520, 6.288)
ball yellow at (2.605, 6.215)
ball red at (1.975126827, 1.367093014)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
simulation(default)
  .preset(three_cushion)
  .max_events(24)
trace(max_events: 24)
shot(cue).heading(91.149deg).speed(168ips).tip(side: 0.37R, height: 0.19R).using(default)
