# Three-rails-first bank/bricole diagnostic.
# The cue ball banks Left -> Right -> Left -> Right before contacting red, then yellow.
table three_cushion_carom_10ft
game three_cushion
ball cue at (3.014, 6.964)
ball yellow at (2.066008867, 4.974809118)
ball red at (1.904, 5.144)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
simulation(default)
  .preset(three_cushion)
  .max_events(40)
trace(max_events: 40)
shot(cue).heading(264.580618956deg).speed(220.685276865ips).tip(side: -0.122396789R, height: 0.159503603R).using(default)
