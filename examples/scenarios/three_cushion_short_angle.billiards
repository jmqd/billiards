# Three-cushion short-angle practice layout on a heated pocketless table.
# Goal: test a compact rail-first path with carom-size balls and livelier cushions.
table three_cushion_carom_10ft
game three_cushion
ball cue at (0.85, 5.85)
ball yellow at (1.90, 3.95)
ball red at (3.20, 1.35)
cue_strike(default).mass_ratio(1.0).energy_loss(0.08)
simulation(default)
  .preset(three_cushion)
  .max_events(12)
trace(max_events: 12)
shot(cue).heading(118deg).speed(84ips).tip(side: -0.20R, height: 0.10R).using(default)
